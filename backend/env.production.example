# Production Environment Variables
# Copy this file to .env and update with your production values

# Application
APP_NAME=E-Commerce API
APP_VERSION=1.0.0
DEBUG=False
ENVIRONMENT=production

# API
API_V1_PREFIX=/api/v1

# Database
# Use connection pooling in production
DATABASE_URL=postgresql+asyncpg://user:password@db-host:5432/ecommerce_db?pool_size=20&max_overflow=10

# Security - IMPORTANT: Change these in production!
SECRET_KEY=your-very-long-and-random-secret-key-minimum-32-characters-change-this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS - Add your production frontend URLs
CORS_ORIGINS=["https://yourdomain.com","https://www.yourdomain.com"]

# Frontend URL
FRONTEND_URL=https://yourdomain.com

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=api.yourdomain.com,yourdomain.com
